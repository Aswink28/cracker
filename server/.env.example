# ---------------------------------------------------------------------------
# Backend environment. Copy to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed or exposed to the frontend.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/crackers
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crackers?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/crackers

# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-this-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API.
# Add your production storefront domain before going live.
FRONTEND_URL=http://localhost:3000

# --- Cloudinary (product image hosting) ------------------------------------
# Sign up at cloudinary.com; these are on the dashboard. Uploads return 503
# until all three are set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=crackers

# --- First admin account (used by `npm run seed` only) ----------------------
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# --- Storefront cache invalidation -----------------------------------------
# Lets the API tell Next.js to re-render catalogue pages after an admin edit.
# REVALIDATE_SECRET must match NEXT_REVALIDATE_SECRET in the frontend .env.
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=replace-with-a-shared-random-string
