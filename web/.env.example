# ---------------------------------------------------------------------------
# Storefront environment. Copy to `.env.local` and fill in real values.
#
# Anything prefixed NEXT_PUBLIC_ is embedded in the JavaScript sent to the
# browser. Never put a secret behind that prefix.
# ---------------------------------------------------------------------------

# --- URLs -------------------------------------------------------------------

# Public URL of this site, no trailing slash. Used for canonical URLs, Open
# Graph tags, the sitemap and robots.txt - getting this wrong breaks SEO, so
# set the real domain before going live.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API, including the /api suffix. Used by the browser (admin panel).
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Optional server-side API URL. Set this if server rendering should reach the
# API over a private network address instead of the public one. Falls back to
# NEXT_PUBLIC_API_URL when unset.
API_URL=http://localhost:5000/api

# --- Store identity ---------------------------------------------------------
# REPLACE ALL OF THESE BEFORE LAUNCH.
# Values left blank are simply omitted from the page and from the
# LocalBusiness structured data - nothing is invented to fill a gap.

NEXT_PUBLIC_STORE_NAME=Crackers Store
NEXT_PUBLIC_STORE_TAGLINE=Quality crackers at fair prices

# WhatsApp number in international format, digits only, country code first.
# No +, no spaces, no dashes. Example for India: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Phone number as it should be dialled and displayed, e.g. +919876543210
NEXT_PUBLIC_STORE_PHONE=

NEXT_PUBLIC_STORE_EMAIL=

# Full shop address on one line. Leave blank if there is no physical store -
# do not enter a placeholder city.
NEXT_PUBLIC_STORE_ADDRESS=

# Free text, e.g. "Mon-Sat 09:00-20:00"
NEXT_PUBLIC_STORE_HOURS=

# Google Maps link to the shop, if there is one.
NEXT_PUBLIC_STORE_MAPS_URL=

# --- Cache invalidation -----------------------------------------------------
# Shared secret the backend uses to call POST /api/revalidate after an admin
# edit. Must match REVALIDATE_SECRET in the backend .env. Server-only: no
# NEXT_PUBLIC_ prefix, so it is never shipped to the browser.
NEXT_REVALIDATE_SECRET=replace-with-a-shared-random-string

# --- Digital catalogue ------------------------------------------------------
# Direct URL to a catalogue/price-list PDF (Cloudinary, Drive, S3 - anywhere
# publicly reachable). Leave blank and the homepage shows a "Request the
# catalogue" WhatsApp button instead of a dead download link.
NEXT_PUBLIC_CATALOGUE_URL=
